<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Canonical host: 301 redirect non-www -> www (matches canonical tags, one true address)
	RewriteCond %{HTTP_HOST} ^brandkraf\.com$ [NC]
	RewriteRule ^(.*)$ https://www.brandkraf.com/$1 [R=301,L]

	# One canonical URL per page: strip trailing slashes (301) so /contact/ and
	# /contact never split ranking signals. Root and real files are untouched.
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^(.+)/$ /$1 [R=301,L]

	# Serve the prerendered flat HTML (contact.html) for its extensionless URL
	# (/contact) — a direct 200 that matches the page's canonical exactly.
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{DOCUMENT_ROOT}/$1.html -f
	RewriteRule ^(.+?)$ /$1.html [L]

	# SPA fallback: serve index.html for anything that isn't a real file or directory
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]

	# A real directory WITHOUT its own index.html (e.g. /team, or a stale folder left
	# behind by a deploy sync) would otherwise return 403 Forbidden — fall back to the
	# SPA shell instead so every shared/deep link always renders.
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteCond %{REQUEST_FILENAME}/index.html !-f
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# HTML / app routes: never edge-cache, always revalidate so new deploys appear instantly
	Header set Cache-Control "public, s-maxage=0, max-age=0, must-revalidate"

	# Hashed build assets are content-addressed (filenames change per build) — cache hard
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
